            await bot.swapManager.swapSuiToDeep(suiToSwap);
            await new Promise(resolve => setTimeout(resolve, 1500));
          }
        }

        // 4. 新Above2(6番) の構築
        // レンジ下限は、スライド後の Above1（旧Above2）の上限
        const finalLower = rangeUpperAbove2_prev > 0 ? rangeUpperAbove2_prev : price * (1 + offset2);
        const newUpper = finalLower * (1 + width);

        let amountToInvest = 0;
        let isCoinA = false;

        const balance = await this.bot1.lpManager.checkBalance();
        if (isCoinA) {
          // ダミー分岐回避
        }
        if (isBot1) {
          amountToInvest = Math.max(0, balance.suiBalance - GAS_RESERVE) * 0.98;
          isCoinA = false; // SUI-USDC の Above は SUI (CoinB)
        } else {
