        // 2. スライド前の状態をキャプチャ
        const rangeUpperAbove2_prev = bot.state.rangeUpperAbove2;

        // ポジション変数を右にスライド（Below2 ← Below1, Below1 ← Current, Current ← Above1, Above1 ← Above2, Above2 = null）
        bot.state.lpPositionIdBelow2 = bot.state.lpPositionIdBelow1;
        bot.state.rangeLowerBelow2 = bot.state.rangeLowerBelow1;
        bot.state.rangeUpperBelow2 = bot.state.rangeUpperBelow1;

        bot.state.lpPositionIdBelow1 = bot.state.lpPositionIdCurrent;
        bot.state.rangeLowerBelow1 = bot.state.rangeLowerCurrent;
        bot.state.rangeUpperBelow1 = bot.state.rangeUpperCurrent;

        bot.state.lpPositionIdCurrent = bot.state.lpPositionIdAbove1;
        bot.state.rangeLowerCurrent = bot.state.rangeLowerAbove1;
        bot.state.rangeUpperCurrent = bot.state.rangeUpperAbove1;

        bot.state.lpPositionIdAbove1 = bot.state.lpPositionIdAbove2;
        bot.state.rangeLowerAbove1 = bot.state.rangeLowerAbove2;
        bot.state.rangeUpperAbove1 = bot.state.rangeUpperAbove2;

        bot.state.lpPositionIdAbove2 = null;
        bot.state.rangeLowerAbove2 = 0;
        bot.state.rangeUpperAbove2 = 0;

        // 3. 回収アセットの自動スワップ
        // 新しく作る Above2(6番) は SUI-USDC なら SUIが必要、DEEP-SUI なら DEEPが必要
        if (isBot1) {
          // SUI-USDC: Below2をクローズして得られた USDC を SUI へスワップ
          const balance = await this.bot1.lpManager.checkBalance();
          const usdcToSwap = balance.usdcBalance;
          if (usdcToSwap > 0.1) {
            Logger.info(`[${bot.name}] 回収した USDC を SUI へスワップします: $${usdcToSwap.toFixed(2)} USDC -> SUI...`);
            await bot.swapManager.swapUsdcToSui(usdcToSwap);
            await new Promise(resolve => setTimeout(resolve, 1500));
          }
        } else {
          // DEEP-SUI: Below2をクローズして得られた SUI を DEEP へスワップ
          const balance = await this.bot1.lpManager.checkBalance();
